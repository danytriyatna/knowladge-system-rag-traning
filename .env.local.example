# Salin file ini ke .env.local lalu isi dengan API key milikmu.
# Dapatkan API key gratis di https://aistudio.google.com/apikey

GEMINI_API_KEY=
# Opsional, default: gemini-3.6-flash
GEMINI_MODEL=gemini-3.6-flash

# Akun admin pertama, dibuat otomatis saat pertama kali ada yang mencoba login
# (hanya jika tabel users masih kosong). Ganti kata sandinya setelah login pertama.
ADMIN_EMAIL=
ADMIN_PASSWORD=
