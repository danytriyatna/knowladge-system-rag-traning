# Konfigurasi lingkungan JP-Insight
#
# Salin berkas ini menjadi .env.local lalu isi nilainya. Berkas .env.local
# TIDAK boleh dimasukkan ke git dan tidak boleh diserahkan ke pihak mana pun —
# seluruh nilainya bersifat rahasia.
#
# Variabel bertanda [WAJIB] harus terisi; aplikasi gagal dijalankan tanpanya.

# =====================================================================
# BASIS DATA — Supabase Postgres
# =====================================================================

# [WAJIB] Connection string Supabase lewat pooler (Supavisor, port 6543).
# Ambil dari: Supabase Dashboard > Project Settings > Database > Connection
# string > Transaction pooler.
#
# Catatan: sengaja memakai pooler (6543), bukan koneksi langsung (5432),
# karena koneksi langsung membutuhkan rute IPv6 yang tidak selalu tersedia.
DATABASE_URL_POOLED=postgresql://postgres.<ref>:<password>@<host>:6543/postgres

# =====================================================================
# PENYIMPANAN BERKAS — Supabase Storage
# =====================================================================
# Berkas PDF naskah disimpan pada bucket "documents-pdfs".

# [WAJIB] URL proyek Supabase, mis. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# [WAJIB] Service role key. HANYA dipakai di sisi server dan melewati RLS —
# jangan pernah diekspos ke peramban atau dimasukkan ke kode sisi klien.
SUPABASE_SERVICE_ROLE_KEY=

# =====================================================================
# KEAMANAN SESI
# =====================================================================

# [WAJIB] Kunci penanda tangan cookie sesi. Bangkitkan nilai acak panjang:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Mengganti nilai ini akan membatalkan seluruh sesi yang sedang berjalan.
SESSION_SECRET=

# =====================================================================
# MODEL BAHASA — Google Gemini
# =====================================================================
# Dipakai hanya untuk menyusun kalimat jawaban dan memilah pernyataan celah
# riset. Pembentukan embedding berjalan lokal di server, tanpa panggilan API.

# [WAJIB] API key. Dapat dibuat di https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opsional. Model untuk ekstraksi teks PDF hasil pindai (lib/gemini.ts).
GEMINI_MODEL=gemini-3.6-flash

# Opsional. Model untuk tanya jawab, kajian, dan panen celah riset
# (lib/chat.ts, lib/claims.ts). Model ringan sudah memadai.
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite

# =====================================================================
# SUMBER NASKAH — arsip jurnal
# =====================================================================

# Opsional. Alamat OAI-PMH arsip Jurnal Permukiman untuk sinkronisasi
# terbitan baru. Biarkan kosong untuk memakai nilai bawaan di bawah ini.
OJS_OAI_URL=https://jurnalpermukiman.pu.go.id/index.php/JP/oai

# =====================================================================
# AKUN ADMINISTRATOR PERTAMA
# =====================================================================
# Dibuat otomatis saat ada percobaan login pertama, HANYA bila tabel users
# masih kosong. Ganti kata sandinya segera setelah berhasil masuk.

ADMIN_EMAIL=
ADMIN_PASSWORD=
