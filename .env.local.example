# Konfigurasi lingkungan JP-Insight
#
# Salin berkas ini menjadi .env.local lalu isi nilainya. Berkas .env.local
# TIDAK boleh dimasukkan ke git dan tidak boleh diserahkan ke pihak mana pun —
# seluruh nilainya bersifat rahasia.
#
# Variabel bertanda [WAJIB] harus terisi; aplikasi gagal dijalankan tanpanya.

# =====================================================================
# BASIS DATA — PostgreSQL Docker Lokal
# =====================================================================

# [WAJIB] Connection string PostgreSQL Lokal (port 5432, database knowledge_db).
DATABASE_URL=postgresql://admin:adminadmin@127.0.0.1:5432/knowledge_db
DATABASE_URL_POOLED=postgresql://admin:adminadmin@127.0.0.1:5432/knowledge_db

# =====================================================================
# PENYIMPANAN BERKAS — Local Disk Storage
# =====================================================================
# Berkas PDF naskah disimpan di direktori fisik lokal (mirip MQC).
DOCUMENT_STORAGE_DIR=storage/documents-pdfs

# =====================================================================
# KEAMANAN SESI (NextAuth v5)
# =====================================================================

# [WAJIB] Kunci rahasia penandatangan sesi NextAuth v5 (atau fallback SESSION_SECRET).
# Bangkitkan nilai acak panjang:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Mengganti nilai ini akan membatalkan seluruh sesi yang sedang berjalan.
AUTH_SECRET=
SESSION_SECRET=

# URL publik aplikasi untuk NextAuth (mis. http://localhost:3001 atau http://<IP>:3101).
AUTH_URL=http://localhost:3001

# Set "false" untuk akses HTTP tanpa HTTPS (localhost atau Docker IP:port),
# atau "true" bila berjalan di balik reverse proxy HTTPS.
AUTH_USE_SECURE_COOKIES=false

# =====================================================================
# MODEL BAHASA — Google Gemini
# =====================================================================
# Dipakai hanya untuk menyusun kalimat jawaban dan memilah pernyataan celah
# riset. Pembentukan embedding berjalan lokal di server, tanpa panggilan API.

# [WAJIB] API key. Dapat dibuat di https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opsional. Model untuk ekstraksi teks PDF hasil pindai (lib/gemini.ts).
GEMINI_MODEL=gemini-3.6-flash

# Opsional. Model untuk tanya jawab, kajian, dan panen celah riset
# (lib/chat.ts, lib/claims.ts). Model ringan sudah memadai.
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite

# =====================================================================
# SUMBER NASKAH — arsip jurnal
# =====================================================================

# Opsional. Alamat OAI-PMH arsip Jurnal Permukiman untuk sinkronisasi
# terbitan baru. Biarkan kosong untuk memakai nilai bawaan di bawah ini.
OJS_OAI_URL=https://jurnalpermukiman.pu.go.id/index.php/JP/oai

# Opsional. URL publik lintas aplikasi untuk Docker/VPS & tautan sitasi OJS
OJS_PUBLIC_URL=http://localhost:8000/index.php/JP
# Opsional. Override URL internal hanya untuk crawl portal (bila di dalam Docker berbeda dari URL publik)
OJS_PORTAL_CRAWL_URL=
# Opsional. Daftar origin tambahan yang diizinkan memanggil /api/widget/chat (dipisah koma)
WIDGET_ALLOWED_ORIGINS=
# Opsional. Pengaman publik widget chat: batas panjang pertanyaan & kuota per IP
WIDGET_MAX_QUESTION_LENGTH=500
WIDGET_RATE_LIMIT_PER_MIN=10
WIDGET_RATE_LIMIT_PER_DAY=50
MQC_PUBLIC_URL=http://localhost:3000/dashboard
OJS_ARTICLE_BASE_URL=http://localhost:8000/index.php/JP/article/view

# =====================================================================
# AKUN ADMINISTRATOR PERTAMA
# =====================================================================
# Dibuat otomatis saat ada percobaan login pertama, HANYA bila tabel users
# masih kosong. Ganti kata sandinya segera setelah berhasil masuk.

ADMIN_EMAIL=
ADMIN_PASSWORD=
